{
  "name": "focus-pet",
  "version": "0.2.0",
  "private": true,
  "description": "A tiny desktop focus companion MVP.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer",
    "preview": "vite preview",
    "electron": "node_modules\\.bin\\electron.cmd .",
    "start": "npm run build && npm run electron",
    "check:live2d": "node scripts/check-live2d-assets.mjs",
    "verify": "npm run check:live2d && npm run build && npm run package:win",
    "build:renderer": "tsc -b && vite build",
    "package:win": "npm run build:renderer && electron-builder --win --dir --config.electronDist=node_modules/electron/dist",
    "build:win": "npm run build:renderer && electron-builder --win portable",
    "dist": "npm run build:win"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "l2d": "^2.1.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "electron-builder": "^26.0.12",
    "electron": "^39.2.7",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "build": {
    "appId": "com.focuspet.app",
    "productName": "Focus Pet",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      }
    ],
    "asarUnpack": [
      "dist/assets/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "Focus Pet",
      "signExecutable": false,
      "target": [
        "portable"
      ]
    }
  }
}
